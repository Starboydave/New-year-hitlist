# ───────────── Server ─────────────
PORT=3000
NODE_ENV=development
# Public https URL (ngrok in dev). Only used by the print:vapi helper.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
TZ=Africa/Lagos

# ───────────── Vapi ─────────────
# Same value you put in the "Server URL Secret" (x-vapi-secret) in the Vapi dashboard.
VAPI_WEBHOOK_SECRET=change-me-long-random-string
# Hard latency budget for any tool call before the Ghost Transfer fires (ms).
VAPI_TOOL_BUDGET_MS=800

# ───────────── Human failover / routing (E.164) ─────────────
# Ghost Transfer target: human backup ring group / hunt number.
BACKUP_RING_GROUP_NUMBER=+2348000000001
# Existing clients & complaints are blind-transferred here.
PROPERTY_MANAGER_NUMBER=+2348000000002

# ───────────── Google (one OAuth client for Calendar + Sheets + Gmail) ─────────────
# Create an OAuth client (Desktop app), enable Calendar, Sheets and Gmail APIs,
# then run `npm run google:token` once to obtain the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Sheet with two tabs: "Leads" (written by the server) and "Clients" (phone numbers in column A).
GOOGLE_SHEET_ID=
SHEET_LEADS_TAB=Leads
SHEET_CLIENTS_TAB=Clients

# ───────────── Tour scheduling ─────────────
TOUR_DURATION_MIN=60
# Lagos-local business hours for tours (24h clock).
TOUR_START_HOUR=10
TOUR_END_HOUR=17

# ───────────── Lead qualification (NGN) ─────────────
# Budget >= this is a "high-ticket" lead (gets a Gmail follow-up draft).
HIGH_TICKET_MIN_NGN=50000000
# Budget below this is disqualified and not booked. Set 0 to disable.
MIN_BUDGET_NGN=5000000

# ───────────── Green API (WhatsApp) ─────────────
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_HOST=https://api.green-api.com
# Business owner's WhatsApp number for the 6 PM executive briefing (digits, with country code).
OWNER_WHATSAPP=2348000000000
# Draft emails are created in this mailbox's Drafts folder (the mailbox that authorised the refresh token).
OWNER_EMAIL=owner@example.com
BUSINESS_NAME=Your Luxury Properties & Events

# ───────────── Cron ─────────────
BRIEFING_CRON=0 18 * * *
# Protects POST /api/admin/run-briefing (manual trigger for testing).
ADMIN_TOKEN=change-me-too
