{
  "name": "voice-receptionist",
  "version": "1.0.0",
  "description": "Vapi webhook & middleware server for the AI Voice Receptionist",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "print:vapi": "tsx scripts/print-vapi-config.ts",
    "google:token": "tsx scripts/get-refresh-token.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "googleapis": "^185.0.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
