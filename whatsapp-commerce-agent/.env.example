PORT=3000

# Supabase (Project Settings -> API). Use the service_role key: server-side only, never ship to a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# App Settings -> Basic -> App Secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Paystack (Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Optional: where Paystack redirects the customer after paying
PAYSTACK_CALLBACK_URL=
# Paystack requires an email; users without one get <phone>@<this domain>
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=customers.example.com
